local function switchTab(toHide, toShow)
    TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 280, 0, 180)}):Play()
    toHide.Visible = false
    toShow.Visible = true
end

SettingsBtn.MouseButton1Click:Connect(function() switchTab(MainTab, SettingsTab) end)
