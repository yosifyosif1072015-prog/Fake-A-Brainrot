-- Demo feature button toggles (UI only)
local activeFeatures = {
    Speed = false,
    Flight = false,
    Gravity = false
}

local function setFeatureButtonState(button, enabled)
    if enabled then
        button.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
        button.Text = button.Text:gsub("⚡", "✅"):gsub("🛩️", "✅"):gsub("🌍", "✅")
    else
        button.BackgroundColor3 = Color3.fromRGB(105, 80, 200)
        button.Text = button.Text:gsub("✅", "⚡"):gsub("✅", "🛩️"):gsub("✅", "🌍")
    end
end

