-- Button click effect
local function animatePress(button)
    local originalSize = button.Size
    button.MouseButton1Down:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.08), {
            Size = originalSize - UDim2.new(0, 10, 0, 4)
        }):Play()
    end)

    button.MouseButton1Up:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.08), {
            Size = originalSize
        }):Play()
    end)
end

for _, btn in ipairs({
    StartBtn, SettingsNavBtn,
    SpeedBtn, FlightBtn, GravityBtn, MaxSpeedBtn, FlightMaxBtn, StartBackBtn,
    SettingsBackBtn, CloseBtn
}) do
    animatePress(btn)
end

-- Navigation
local function switchTo(page)
    MainPage.Visible = false
    StartPage.Visible = false
    SettingsPage.Visible = false
    page.Visible = true
end

