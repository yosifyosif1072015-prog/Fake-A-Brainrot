local function animatePress(button)
    local originalSize = button.Size
    button.MouseButton1Down:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.08), {
            Size = originalSize - UDim2.new(0, 8, 0, 4)
        }):Play()
    end)

    button.MouseButton1Up:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.08), {
            Size = originalSize
        }):Play()
    end)
end

for _, btn in ipairs({
    StartBtn, SettingsBtn,
    DetectionBtn, SpeedBtn, FlightBtn, GravityBtn, StartBackBtn,
    LangBtn, ThemeBtn, SettingsBackBtn, CloseBtn
}) do
    animatePress(btn)
end

local function switchTo(page)
    MainPage.Visible = false
    StartPage.Visible = false
    SettingsPage.Visible = false
    page.Visible = true
end

StartBtn.MouseButton1Click:Connect(function()
    switchTo(StartPage)
end)

SettingsBtn.MouseButton1Click:Connect(function()
    switchTo(SettingsPage)
end)

StartBackBtn.MouseButton1Click:Connect(function()
    switchTo(MainPage)
end)

SettingsBackBtn.MouseButton1Click:Connect(function()
    switchTo(MainPage)
end)

CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

