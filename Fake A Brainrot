local function switchPage(pageName)
    for _, page in pairs(Pages) do
        page.Visible = false
    end
    Pages[pageName].Visible = true
end

local function animatePress(btn)
    local originalSize = btn.Size
    btn.MouseButton1Down:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.08, Enum.EasingStyle.Linear), {
            Size = originalSize - UDim2.new(0, 8, 0, 4)
        }):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.08, Enum.EasingStyle.Linear), {
            Size = originalSize
        }):Play()
    end)
end

for _, btn in ipairs({
    StartBtn, SettingsBtn,
    DetectionBtn, SpeedBtn, FlightBtn, GravityBtn, StartBackBtn,
    LangBtn, ThemeBtn, SettingsBackBtn
}) do
    animatePress(btn)
end

