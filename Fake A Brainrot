-- [منطق الكشف]
-- ==========================================
local HiddenPartNames = {
    "UpperTorso",
    "LowerTorso",
    "Head",
    "LeftHand",
    "RightHand",
    "LeftUpperArm",
    "RightUpperArm",
    "LeftUpperLeg",
    "RightUpperLeg",
    "LeftLowerLeg",
    "RightLowerLeg"
}

local isRunning = false
local scanLoop = nil

local TargetContainer = Workspace:FindFirstChild("FakeEggESPContainer") or Instance.new("Folder")
TargetContainer.Name = "FakeEggESPContainer"
TargetContainer.Parent = Workspace

local function clearPlayerESP(player)
    local folder = TargetContainer:FindFirstChild(player.Name .. "_FakeESP")
    if folder then
        folder:Destroy()
    end
end

local function createPlayerESP(player, color)
    clearPlayerESP(player)

    local folder = Instance.new("Folder")
    folder.Name = player.Name .. "_FakeESP"
    folder.Parent = TargetContainer

    local highlight = Instance.new("Highlight")
    highlight.Name = "FakeHighlight"
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0.2
    highlight.Adornee = player.Character
    highlight.Parent = folder
end

local function isHiddenPart(part)
    if not part or not part:IsA("BasePart") then
        return false
    end

    if part.Transparency >= 0.5 then
        return true
    end

    if part.LocalTransparencyModifier and part.LocalTransparencyModifier >= 0.5 then
        return true
    end

    return false
end

local function isPlayerDisguised(player)
    if not player or not player.Character then
        return false
    end

    local character = player.Character
    local hiddenCount = 0

    for _, partName in ipairs(HiddenPartNames) do
        local part = character:FindFirstChild(partName)
        if part and isHiddenPart(part) then
            hiddenCount += 1
        end
    end

    if hiddenCount >= 3 then
        return true
    end

    return false
end

local function scanPlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if player.Character and player.Character:FindFirstChild("Humanoid") then
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    if isPlayerDisguised(player) then
                        createPlayerESP(player, Color3.fromRGB(0, 255, 120))
                    else
                        clearPlayerESP(player)
                    end
                else
                    clearPlayerESP(player)
                end
            else
                clearPlayerESP(player)
            end
        end
    end
end

local function setButtonState(running)
    isRunning = running
    if isRunning then
        ActiveBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        ActiveBtn.Text = "🟢 Radar ON"
    else
        ActiveBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        ActiveBtn.Text = "🔴 Radar OFF"
    end
end

local function startScan()
    if scanLoop then
        task.cancel(scanLoop)
        scanLoop = nil
    end

    scanLoop = task.spawn(function()
        while isRunning do
            scanPlayers()
            task.wait(0.5)
        end
    end)
end

local function toggleScan()
    setButtonState(not isRunning)

    if isRunning then
        startScan()
    else
        if scanLoop then
            task.cancel(scanLoop)
            scanLoop = nil
        end
    end
end

CloseBtn.MouseButton1Click:Connect(function()
