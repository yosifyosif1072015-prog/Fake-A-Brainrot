-- Detection system
local TargetContainer = Workspace:FindFirstChild("FakeEggESPContainer") or Instance.new("Folder")
TargetContainer.Name = "FakeEggESPContainer"
TargetContainer.Parent = Workspace

local function clearPlayerESP(player)
    local folder = TargetContainer:FindFirstChild(player.Name .. "_FakeESP")
    if folder then
        folder:Destroy()
    end
end

local function createRadarMark(rootPart, text, color)
    if not rootPart or not rootPart.Parent then
        return
    end

    local idName = rootPart:GetDebugId() .. "_FakeMark"
    if TargetContainer:FindFirstChild(idName) then
        return
    end

    local trackingFolder = Instance.new("Folder")
    trackingFolder.Name = idName
    trackingFolder.Parent = TargetContainer

    local sphere = Instance.new("SphereHandleAdornment")
    sphere.Name = "FakeSphere"
    sphere.Adornee = rootPart
    sphere.Radius = 3.5
    sphere.Color3 = color
    sphere.AlwaysOnTop = true
    sphere.ZIndex = 10
    sphere.Transparency = 0.4
    sphere.Parent = trackingFolder

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "FakeLabel"
    billboard.Parent = trackingFolder
    billboard.Size = UDim2.new(0, 180, 0, 45)
    billboard.Adornee = rootPart
    billboard.AlwaysOnTop = true
    billboard.StudsOffset = Vector3.new(0, 5, 0)

    local label = Instance.new("TextLabel")
    label.Parent = billboard
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color
    label.TextSize = 15
    label.Font = Enum.Font.SourceSansBold
    label.TextStrokeTransparency = 0
end

local HiddenPartNames = {
    "UpperTorso",
    "LeftHand",
    "RightUpperLeg",
    "RightHand",
    "LeftUpperLeg",
    "Head",
    "LowerTorso",
    "LeftUpperArm",
    "RightUpperArm"
}

local function isHiddenPart(part)
    if not part or not part:IsA("BasePart") then
        return false
    end

    if part.Transparency >= 0.5 then
        return true
    end

    if part.LocalTransparencyModifier and part.LocalTransparencyModifier >= 0.5 then
        return true
    end

    return false
end

local function isPlayerDisguised(player)
    if not player or not player.Character then
        return false
    end

    local character = player.Character
    local hiddenCount = 0

    for _, partName in ipairs(HiddenPartNames) do
        local part = character:FindFirstChild(partName)
        if part and isHiddenPart(part) then
            hiddenCount += 1
        end
    end

    if hiddenCount >= 3 then
        return true
    end

    return false
end

local function scanForFakeEggs()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character and character:FindFirstChild("Humanoid") then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    if isPlayerDisguised(player) then
                        createRadarMark(rootPart, "⚠️ بيضة متنكرة ⚠️", Color3.fromRGB(255, 50, 50))
                    else
                        local mark = TargetContainer:FindFirstChild(rootPart:GetDebugId() .. "_FakeMark")
                        if mark then
                            mark:Destroy()
                        end
                    end
                end
            end
        end
    end
end

local function startDetection()
    if detectionThread then
        task.cancel(detectionThread)
        detectionThread = nil
    end

    detectionThread = task.spawn(function()
        while isRunning do
            scanForFakeEggs()
            task.wait(0.4)
        end
    end)
end

local function toggleDetection()
    isRunning = not isRunning
    updateLocalization()

    if isRunning then
        ActiveBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
        startDetection()
    else
        ActiveBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        if detectionThread then
            task.cancel(detectionThread)
            detectionThread = nil
        end
        TargetContainer:ClearAllChildren()
    end
end

