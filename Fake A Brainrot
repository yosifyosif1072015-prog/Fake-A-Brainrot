local TargetContainer = workspace:FindFirstChild("XenoPartESPContainer") or Instance.new("Folder")
TargetContainer.Name = "XenoPartESPContainer"
TargetContainer.Parent = workspace

local function createTargetESP(rootPart, color)
    if not rootPart or not rootPart.Parent then
        return
    end

    local idName = tostring(rootPart) .. "_PartHider"
    if TargetContainer:FindFirstChild(idName) then
        return
    end

    local trackingFolder = Instance.new("Folder")
    trackingFolder.Name = idName
    trackingFolder.Parent = TargetContainer

    local sphere = Instance.new("SphereHandleAdornment")
    sphere.Name = "SmartSphere"
    sphere.Adornee = rootPart
    sphere.Radius = 3.5
    sphere.Color3 = color
    sphere.AlwaysOnTop = true
    sphere.ZIndex = 10
    sphere.Transparency = 0.4
    sphere.Parent = trackingFolder
end

local function scanForFakeEggs()
    for _, descendant in ipairs(workspace:GetDescendants()) do
        if descendant:IsA("BasePart") then
            local lowerName = descendant.Name:lower()
            if string.find(lowerName, "egg") or string.find(lowerName, "fake") or string.find(lowerName, "xeno") then
                createTargetESP(descendant, Color3.fromRGB(255, 140, 0))
            end
        end
    end
end

local function toggleScan()
    isRunning = not isRunning
    if isRunning then
        if loopThread then
            task.cancel(loopThread)
        end

        loopThread = task.spawn(function()
            while isRunning and ScreenGui.Parent do
                scanForFakeEggs()
                task.wait(1)
            end
        end)
    else
        if loopThread then
            task.cancel(loopThread)
            loopThread = nil
        end
    end

    updateLocalization()
end

