-- تأثير الـ RGB المتحرك بسلاسة فائقة للعناوين
local function applyRGBEffect(textLabel)
    task.spawn(function()
        local hue = 0
        while textLabel and textLabel.Parent do
            hue = hue + 1
            if hue > 360 then hue = 0 end
            textLabel.TextColor3 = Color3.fromHSV(hue/360, 0.7, 1)
            task.wait(0.02)
        end
    end)
end

-- تأثيرات حركية (Animations) عند الضغط على الأزرار والتنقل
local TweenService = game:GetService("TweenService")
local function applyButtonEffects(button)
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundTransparency = 0.2}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
    end)
end

