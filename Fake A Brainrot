local function spawnStar()
    local star = Instance.new("TextLabel")
    star.Parent = StarsContainer
    star.BackgroundTransparency = 1
    star.Text = "✦" -- شكل النجمة
    star.TextColor3 = Color3.fromRGB(255, 255, 255)
    star.TextSize = math.random(8, 14)
    star.Font = Enum.Font.SourceSansBold
    star.ZIndex = 1
    
    -- موقع عشوائي في أعلى اللوحة
    star.Position = UDim2.new(math.random(), 0, -0.1, 0)
    star.TextTransparency = 1
    
    -- أنيميشن الحركة والتلاشي للأسفل
    local TweenService = game:GetService("TweenService")
    local duration = math.random(3, 6)
    
    local fallTween = TweenService:Create(star, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Position = UDim2.new(star.Position.X.Scale, 0, 1.1, 0)
    })
    local fadeInTween = TweenService:Create(star, TweenInfo.new(0.5), {TextTransparency = 0.3})
    local fadeOutTween = TweenService:Create(star, TweenInfo.new(0.5), {TextTransparency = 1})
    
    fadeInTween:Play()
    fallTween:Play()
    
    task.delay(duration - 0.5, function()
        fadeOutTween:Play()
    end)
    
    fallTween.Completed:Connect(function()
        star:Destroy()
    end)
end

-- تشغيل منشئ النجوم التلقائي
local starLoop = task.spawn(function()
    while true do
        spawnStar()
        task.wait(0.4) -- تخرج نجمة جديدة كل جزء من الثانية
    end
end)

