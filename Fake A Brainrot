-- Fake A Brainrot - UI match to screenshot
-- Main panel only: Start + Settings
-- No transparent pages, no empty panels

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer and LocalPlayer:WaitForChild("PlayerGui")

if not LocalPlayer or not PlayerGui then
    return
end

if PlayerGui:FindFirstChild("FakeAEggMainGui") then
    PlayerGui.FakeAEggMainGui:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FakeAEggMainGui"
ScreenGui.Parent = PlayerGui
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
MainFrame.Position = UDim2.new(0.5, -180, 0.4, -110)
MainFrame.Size = UDim2.new(0, 360, 0, 210)
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.BorderSizePixel = 0
MainFrame.ClipsDescendants = true

local OuterBorder = Instance.new("UIStroke")
OuterBorder.Name = "OuterBorder"
OuterBorder.Parent = MainFrame
OuterBorder.Color = Color3.fromRGB(255, 140, 0)
OuterBorder.Thickness = 3
OuterBorder.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 12)
Corner.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Parent = MainFrame
Title.Size = UDim2.new(1, 0, 0, 42)
Title.Position = UDim2.new(0, 0, 0, 0)
Title.BackgroundTransparency = 1
Title.Text = "🥚 Fake a Egg"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 18
Title.Font = Enum.Font.SourceSansBold
Title.TextXAlignment = Enum.TextXAlignment.Center
Title.TextYAlignment = Enum.TextYAlignment.Center
Title.ZIndex = 2

local CloseBtn = Instance.new("TextButton")
CloseBtn.Parent = MainFrame
CloseBtn.Position = UDim2.new(0.89, 0, 0, 7)
CloseBtn.Size = UDim2.new(0, 30, 0, 30)
CloseBtn.Text = "X"
CloseBtn.TextColor3 = Color3.fromRGB(255, 90, 90)
CloseBtn.BackgroundTransparency = 1
CloseBtn.TextSize = 20
CloseBtn.Font = Enum.Font.SourceSansBold
CloseBtn.ZIndex = 3

local function addButton(parent, pos, size, text, bgColor)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.Position = pos
    btn.Size = size
    btn.Text = text
    btn.BackgroundColor3 = bgColor
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 15
    btn.BorderSizePixel = 0
    btn.ZIndex = 2

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 10)
    btnCorner.Parent = btn

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Thickness = 1
    btnStroke.Color = Color3.fromRGB(255, 255, 255)
    btnStroke.Transparency = 0.4
    btnStroke.Parent = btn

    return btn
end

local StartBtn = addButton(
    MainFrame,
    UDim2.new(0.12, 0, 0.38, 0),
    UDim2.new(0.76, 0, 0, 55),
    "🚀 Start",
    Color3.fromRGB(20, 180, 90)
)

local SettingsBtn = addButton(
    MainFrame,
    UDim2.new(0.12, 0, 0.68, 0),
    UDim2.new(0.76, 0, 0, 48),
    "⚙️ Settings",
    Color3.fromRGB(85, 85, 90)
)

local function animatePress(button)
    local originalSize = button.Size
    button.MouseButton1Down:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.08), {
            Size = originalSize - UDim2.new(0, 8, 0, 4)
        }):Play()
    end)

    button.MouseButton1Up:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.08), {
            Size = originalSize
        }):Play()
    end)
end

animatePress(StartBtn)
animatePress(SettingsBtn)
animatePress(CloseBtn)

CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

StartBtn.MouseButton1Click:Connect(function()
    StartBtn.Text = "✅ Started"
    StartBtn.BackgroundColor3 = Color3.fromRGB(0, 160, 90)
end)

SettingsBtn.MouseButton1Click:Connect(function()
    SettingsBtn.Text = "⚙️ Settings"
end)
