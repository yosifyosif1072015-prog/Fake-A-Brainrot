local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

local function switchPage(fromPage, toPage, direction)
    toPage.Visible = true
    local toPageTargetPos = UDim2.new(0, 0, 0, 45)
    local fromPageTargetPos = direction == "next" and UDim2.new(-1.2, 0, 0, 45) or UDim2.new(1.2, 0, 0, 45)

    if direction == "next" then
        toPage.Position = UDim2.new(1.2, 0, 0, 45)
    else
        toPage.Position = UDim2.new(-1.2, 0, 0, 45)
    end

    TweenService:Create(fromPage, tweenInfo, {Position = fromPageTargetPos}):Play()
    local toTween = TweenService:Create(toPage, tweenInfo, {Position = toPageTargetPos})
    toTween:Play()
    toTween.Completed:Connect(function()
        if fromPage and fromPage.Parent then
            fromPage.Visible = false
        end
    end)
end

local function applyClickEffect(button)
    local originalSize = button.Size
    button.MouseButton1Down:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.1), {
            Size = originalSize - UDim2.new(0, 12, 0, 4)
        }):Play()
    end)

    button.MouseButton1Up:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.1), {
            Size = originalSize
        }):Play()
    end)
end

applyClickEffect(ActiveBtn)
applyClickEffect(SettingsNavButton)
applyClickEffect(LangButton)
applyClickEffect(ColorButton)
applyClickEffect(BackButton)

